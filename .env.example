# ── Local LLM ────────────────────────────────────────────────────────────────
# URL of an OpenAI-compatible chat completions endpoint that supports
# tool/function calling.
MODEL_ENDPOINT=http://localhost:8000/v1/chat/completions

# Model identifier string sent in the API request body.
MODEL_NAME=local-model

# Bearer token for endpoints that require auth (LiteLLM with key, hosted APIs).
# Leave unset for llama.cpp running locally with no auth.
# MODEL_API_KEY=your-token-here

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file used for persistence.
# The file is created automatically on first run.
# DISCOVERY_DB_PATH=discovery_final.db
